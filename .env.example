PORT=8080
APP_ENV=local
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
JWT_SECRET=replace-me
JWT_ISSUER=auth-demo
JWT_EXPIRY_DAYS=30
OTP_TTL_MINUTES=3

# Email
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@example.com
